```{=html}
<% const cats = [...new Set(items.flatMap(i => i.categories || []))].sort((a, b) => a.localeCompare(b)); %>
<div class="category-filter quarto-listing-category" role="group" aria-label="Filter posts by topic">
<button type="button" class="quarto-listing-category-title active" aria-pressed="true">All posts</button>
<% for (const c of cats) { %><button type="button" class="category" aria-pressed="false" data-category="<%- btoa(encodeURIComponent(c)) %>"><%- c %></button><% } %>
</div>
<ol class="postlist list">
<% for (const item of items) { %>
<li class="post-item" <%= metadataAttrs(item) %>>
<span class="post-date"><%- item.date %></span>
<div>
<h2 class="post-title"><a href="<%- item.path %>"><%- item.title %></a></h2>
<% if (item.description) { %><p class="post-dek"><%= item.description %></p><% } %>
<p class="post-meta"><%- (item.categories || []).join(' · ') %><% if (item['reading-time']) { %> · <%- item['reading-time'] %> read<% } %></p>
</div>
<% if (item.image) { %><div class="post-thumb"><img src="<%- item.image %>" alt="" loading="lazy"></div><% } else { %><div class="post-thumb"></div><% } %>
</li>
<% } %>
</ol>
<p class="listing-no-matching d-none">No posts in this topic yet.</p>
<script>
// Mirror Quarto's active topic (set by a click or by a #category= link)
// into aria-pressed, and mark "All posts" when no topic is active.
(function () {
  var group = document.querySelector('.category-filter');
  if (!group) return;
  var all = group.querySelector('.quarto-listing-category-title');
  var cats = group.querySelectorAll('.category');
  function sync() {
    var any = false;
    cats.forEach(function (b) { var on = b.classList.contains('active'); any = any || on; b.setAttribute('aria-pressed', on); });
    all.classList.toggle('active', !any);
    all.setAttribute('aria-pressed', !any);
  }
  new MutationObserver(sync).observe(group, { subtree: true, attributes: true, attributeFilter: ['class'] });
  sync();
})();
</script>
```
